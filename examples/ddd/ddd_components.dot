digraph "ddd_components" {
  layout="dot";
  rankdir="LR";
  
  graph [
    fontname="Virgil";
    fontsize=20;
    splines="ortho";
    nodesep=1.2;
    ranksep=1.8;
    pad=0.5;
    style="filled";
    color="white";
    label="DDD - Component Architecture";
    labelloc="t";
  ];

  node [
    shape="box";
    style="rounded,filled";
    fillcolor="#ffffff";
    fontname="Virgil";
    fontsize=16;
    penwidth=2.0;
    color="#000000";
    margin=0.2;
  ];

  edge [
    fontname="Virgil";
    fontsize=12;
    penwidth=1.5;
    color="#000000";
    arrowhead="vee";
  ];

  subgraph cluster_domain {
    label="DOMAIN (Core)";
    style="rounded";
    color="#198754";
    bgcolor="#e8f5e9";
    
    subgraph cluster_entities {
      label="Entities / Aggregates";
      style="dashed";
      
      order [label="Order (Aggregate Root)"];
      customer [label="Customer (Aggregate Root)"];
      product [label="Product"];
    }
    
    subgraph cluster_value {
      label="Value Objects";
      style="dashed";
      
      address [label="Address"];
      money [label="Money"];
    }
    
    subgraph cluster_events {
      label="Domain Events";
      style="dashed";
      
      order_placed [label="OrderPlacedEvent"];
      payment_received [label="PaymentReceivedEvent"];
    }
  }

  subgraph cluster_application {
    label="APPLICATION";
    style="rounded";
    color="#0d6efd";
    bgcolor="#e7f1ff";
    
    service [label="Application Service"];
    use_case [label="Use Case"];
    dto [label="DTO"];
  }

  subgraph cluster_infrastructure {
    label="INFRASTRUCTURE";
    style="rounded";
    color="#fd7e14";
    bgcolor="#fff3e0";
    
    repo [label="Repository"];
    mapper [label="Entity Mapper"];
    client [label="External Client"];
  }

  service -> use_case [xlabel="orchestrates"];
  use_case -> dto [xlabel="creates"];
  dto -> order [xlabel="maps_to"];
  
  order -> address [xlabel="has"];
  order -> money [xlabel="has"];
  order -> order_placed [xlabel="emits"];
  
  order_placed -> payment_received [xlabel="triggers"];
  
  order -> repo [xlabel="persisted_by"];
  repo -> mapper [xlabel="uses"];
  mapper -> client [xlabel="implements"];
}
