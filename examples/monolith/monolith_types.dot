digraph "monolith_types" {
  layout="dot";
  rankdir="LR";
  
  graph [
    fontname="Virgil";
    fontsize=20;
    splines="ortho";
    nodesep=1.0;
    ranksep=1.5;
    pad=0.5;
    style="filled";
    color="white";
    label="Monolith - Type System";
    labelloc="t";
  ];

  node [
    shape="box";
    style="rounded,filled";
    fillcolor="#ffffff";
    fontname="Virgil";
    fontsize=16;
    penwidth=2.0;
    color="#000000";
    margin=0.2;
  ];

  edge [
    fontname="Virgil";
    fontsize=12;
    penwidth=1.5;
    color="#000000";
    arrowhead="vee";
  ];

  subgraph cluster_interfaces {
    label="Interfaces";
    style="dashed,rounded";
    color="#6f42c1";
    bgcolor="#f3e5f5";
    
    i_user_service [label="IUserService", shape="diamond", style="dashed", fillcolor="#f3e5f5"];
    i_order_service [label="IOrderService", shape="diamond", style="dashed", fillcolor="#f3e5f5"];
    i_repository [label="IRepository", shape="diamond", style="dashed", fillcolor="#f3e5f5"];
  }

  subgraph cluster_base {
    label="Base Classes";
    style="dashed,rounded";
    color="#0d6efd";
    bgcolor="#e7f1ff";
    
    base_entity [label="BaseEntity\n(id, created_at, updated_at)"];
  }

  subgraph cluster_entities {
    label="Entities";
    style="rounded";
    color="#198754";
    bgcolor="#e8f5e9";
    
    user [label="User\n(id, email, password_hash)"];
    order [label="Order\n(id, user_id, status)"];
    product [label="Product\n(id, name, price)"];
    order_item [label="OrderItem\n(id, order_id, product_id)"];
  }

  subgraph cluster_value_objects {
    label="Value Objects";
    style="dashed,rounded";
    color="#fd7e14";
    bgcolor="#fff3e0";
    
    email [label="Email"];
    money [label="Money"];
    address [label="Address"];
  }

  base_entity -> user [xlabel="extends"];
  base_entity -> order [xlabel="extends"];
  base_entity -> product [xlabel="extends"];
  
  order -> order_item [xlabel="has_many", dir="both", arrowhead="odiamond"];
  user -> order [xlabel="places", dir="both", arrowhead="odiamond"];
  product -> order_item [xlabel="included_in", dir="both", arrowhead="odiamond"];
  
  user -> email [xlabel="has"];
  user -> address [xlabel="shipping_to"];
  order -> money [xlabel="total"];
  
  i_user_service -> user [xlabel="managed_by"];
  i_order_service -> order [xlabel="managed_by"];
  i_repository -> base_entity [xlabel="persists"];
}
