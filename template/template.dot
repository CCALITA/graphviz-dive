digraph "aspect_name" {
  // ============================================
  // ByteByteGo Style Template - Full Standard
  // ============================================

  layout="dot";
  rankdir="LR";
  
  graph [
    fontname="Virgil";
    fontsize=20;
    splines="ortho";
    nodesep=1.0;
    ranksep=1.5;
    pad=0.5;
    style="filled";
    color="white";
    label="Diagram Title";
    labelloc="t";
  ];

  node [
    shape="box";
    style="rounded,filled";
    fillcolor="#ffffff";
    fontname="Virgil";
    fontsize=16;
    penwidth=2.0;
    color="#000000";
    margin=0.2;
  ];

  edge [
    fontname="Virgil";
    fontsize=12;
    penwidth=1.5;
    color="#000000";
    arrowhead="vee";
  ];

  // === YOUR CONTENT HERE ===

  // Subgraph example: External Systems (red border)
  // subgraph cluster_external {
  //   label="External Systems";
  //   style="dashed,rounded";
  //   color="#dc3545";
  //   bgcolor="#fff5f5";
  //   
  //   ext_system [label="External API", shape="ellipse", style="dashed"];
  // }

  // Subgraph example: Services (blue border)
  // subgraph cluster_services {
  //   label="Services";
  //   style="rounded";
  //   color="#0d6efd";
  //   bgcolor="#e7f1ff";
  //   
  //   service [label="Service Name"];
  // }

  // Subgraph example: Data Layer (green border)
  // subgraph cluster_data {
  //   label="Data Layer";
  //   style="rounded";
  //   color="#198754";
  //   bgcolor="#e8f5e9";
  //   
  //   db [label="Database", shape="cylinder"];
  // }

  // Edge example (ALWAYS use xlabel):
  // service -> db [xlabel="query"];
}
