digraph "concurrency" {
  // ============================================
  // Concurrency Diagram Template
  // Focus: Threads, async, events, parallelism
  // ============================================

  layout="dot";
  rankdir="LR";
  
  graph [
    fontname="Virgil";
    fontsize=20;
    splines="ortho";
    nodesep=1.2;
    ranksep=1.8;
    pad=0.5;
    style="filled";
    color="white";
    label="Concurrency Model";
    labelloc="t";
  ];

  node [
    shape="box";
    style="rounded,filled";
    fillcolor="#ffffff";
    fontname="Virgil";
    fontsize=16;
    penwidth=2.0;
    color="#000000";
    margin=0.2;
  ];

  edge [
    fontname="Virgil";
    fontsize=12;
    penwidth=1.5;
    color="#000000";
    arrowhead="vee";
  ];

  // === MAIN THREAD / PROCESS ===
  subgraph cluster_main {
    label="Main Thread / Process";
    style="rounded";
    color="#0d6efd";
    bgcolor="#e7f1ff";
    
    main [label="Main"];
    event_loop [label="Event Loop"];
  }

  // === THREAD POOLS ===
  subgraph cluster_pools {
    label="Thread Pools";
    style="rounded";
    color="#198754";
    bgcolor="#e8f5e9";
    
    pool_http [label="HTTP Pool\n(4 threads)"];
    pool_worker [label="Worker Pool\n(8 workers)"];
    pool_io [label="IO Pool\n(16 threads)"];
  }

  // === ASYNC TASKS ===
  subgraph cluster_async {
    label="Async Tasks";
    style="rounded";
    color="#6f42c1";
    bgcolor="#f3e5f5";
    
    task_1 [label="Task A", shape="ellipse"];
    task_2 [label="Task B", shape="ellipse"];
    task_3 [label="Task C", shape="ellipse"];
  }

  // === SYNCHRONIZATION ===
  subgraph cluster_sync {
    label="Synchronization";
    style="rounded";
    color="#fd7e14";
    bgcolor="#fff3e0";
    
    mutex [label="Mutex", shape="diamond"];
    rwlock [label="RWLock", shape="diamond"];
    semaphore [label="Semaphore", shape="diamond"];
    channel [label="Channel", shape="ellipse"];
    barrier [label="Barrier", shape="diamond"];
  }

  // === MESSAGE QUEUES ===
  subgraph cluster_queues {
    label="Message Queues";
    style="dashed,rounded";
    color="#dc3545";
    bgcolor="#fff5f5";
    
    queue_1 [label="Queue A", shape="cylinder"];
    queue_2 [label="Queue B", shape="cylinder"];
  }

  // === RELATIONSHIPS ===
  // Main spawns pools
  main -> pool_http [xlabel="spawns"];
  main -> pool_worker [xlabel="spawns"];
  main -> event_loop [xlabel="starts"];
  
  // Event loop manages async
  event_loop -> task_1 [xlabel="schedules"];
  event_loop -> task_2 [xlabel="schedules"];
  task_1 -> task_3 [xlabel="awaits"];
  
  // Pools execute tasks
  pool_worker -> task_3 [xlabel="executes"];
  pool_io -> queue_1 [xlabel="push"];
  
  // Synchronization
  pool_http -> mutex [xlabel="locks"];
  task_1 -> rwlock [xlabel="read"];
  task_2 -> channel [xlabel="send"];
  task_3 -> channel [xlabel="recv"];
  
  // Queue connections
  queue_1 -> queue_2 [xlabel="forward"];
}
